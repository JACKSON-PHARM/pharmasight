# =============================================================================
# PharmaSight database (backend / start.py)
# =============================================================================
# On IPv4-only networks (common on Windows), Supabase "Direct connection" (db.*.supabase.co:5432)
# often fails. In the dashboard: Connect → Method "Session pooler" → copy URI, then set:
#
#   DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Use the exact string from Supabase (region and project ref differ per project).
# See also: pharmasight/docs/LOCAL_DEVELOPMENT_SESSION_POOLER.md
# =============================================================================

# DATABASE_URL=

# =============================================================================
# KRA OSCU Gava sandbox — optional overrides for gavaetims.py only.
# Credentials are stored in test_pins.csv (gitignored), keyed by Application Test PIN.
# Each run you type the PIN; the script loads the row from the CSV (or prompts to create it).
# Never commit .env (it is gitignored). Commit .env.example only.
# =============================================================================

# Optional: paste a valid OSCU access_token to skip OAuth.
# BEARER_TOKEN=

# Optional: force a specific cmcKey (bypasses CSV cmc_key and selectInitOsdcInfo).
# CMC_KEY=
