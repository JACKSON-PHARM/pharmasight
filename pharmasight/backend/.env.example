# =============================================================================
# SightOps / shared database (backend / start.py)
# =============================================================================
# On IPv4-only networks (common on Windows), Supabase "Direct connection" (db.*.supabase.co:5432)
# often fails. In the dashboard: Connect → Method "Session pooler" → copy URI, then set:
#
#   DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Use the exact string from Supabase (region and project ref differ per project).
# See also: pharmasight/docs/LOCAL_DEVELOPMENT_SESSION_POOLER.md
# =============================================================================

# DATABASE_URL=

# =============================================================================
# KRA OSCU Gava sandbox — optional overrides for gavaetims.py only.
# Credentials are stored in test_pins.csv (gitignored), keyed by Application Test PIN.
# Each run you type the PIN; the script loads the row from the CSV (or prompts to create it).
# Never commit .env (it is gitignored). Commit .env.example only.
# =============================================================================

# Optional: paste a valid OSCU access_token to skip OAuth.
# BEARER_TOKEN=

# Optional: force a specific cmcKey (bypasses CSV cmc_key and selectInitOsdcInfo).
# CMC_KEY=

# =============================================================================
# KRA infrastructure — background worker + connectivity (not tenant onboarding)
# =============================================================================
# Per-company KRA activation is stored on companies.kra_enabled (platform admin Licensing → eTIMS).
# Enable the worker so queued events are processed (Redis/DB as deployed).
#
KRA_OUTBOX_WORKER_ENABLED=true
#
# Dry-run: dequeue and mark processed without calling KRA:
KRA_OUTBOX_SHADOW_MODE=false
#
# Stock ↔ OSCU: after sales / reductions, queue saveStockMaster from PharmaSight ledger (no insertStockIO).
# KRA_STOCK_LEDGER_SYNC_ENABLED=true
# KRA_STOCK_LEDGER_SYNC_DEBOUNCE_SECONDS=2
#
# After insertStockIO+saveStockMaster, if OSCU rsdQty still differs from ledger, one corrective saveStockMaster.
# KRA_STOCK_IN_FINALIZE_WITH_LEDGER=true
#
# saveTrnsSalesOsdc may reject "item not in stock" briefly after stock updates; retries with jitter:
# KRA_OSDC_SALE_STOCK_PROPAGATION_RETRIES=6
# KRA_OSDC_SALE_STOCK_PROPAGATION_SLEEP_MIN=1.0
# KRA_OSDC_SALE_STOCK_PROPAGATION_SLEEP_MAX=3.5
#
# OSDC forensic: append one JSON line per Pharmasight saveTrnsSalesOsdc attempt (exact payload + headers).
# ETIMS_OSDC_FORENSIC_JSONL_PATH=C:/tmp/pharmasight_osdc.jsonl
# Enable POST /etims/debug/* without DEBUG=true (use only on trusted hosts):
# ETIMS_DEBUG_API_ENABLED=false
#
# Optional single-tenant deploy override (forces sandbox vs production API for ALL branches):
# ETIMS_ENVIRONMENT=sandbox
#
# Branch rows store environment too (admin UI); production OAuth/app registration differs from sandbox.
#
# eTIMS vatCatCd/taxTyCd for sales and saveItem are derived from each item's vat_category + vat_rate
# (see app/services/etims/codes_service.py), not from env vars.
# =============================================================================
